{
  "title": "QueueWatch",
  "uid": "queuewatch",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Jobs by status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "queuewatch_jobs", "legendFormat": "{{status}}" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dead letters",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "queuewatch_jobs{status=\"dead\"}" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total retry attempts",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "queuewatch_job_retries" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue backlog (pending + retrying)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 4 },
      "targets": [
        { "expr": "queuewatch_jobs{status=~\"pending|retrying\"}", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests per second by route",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (route) (rate(queuewatch_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(queuewatch_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "5xx responses",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "sum by (route) (rate(queuewatch_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}

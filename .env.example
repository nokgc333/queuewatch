# docker compose の設定の見本。`.env` にコピーして使う(`.env` は git に入れない)。

# Redis のパスワード(内部ネットワークだけで使う。公開する環境では、必ず変える)
REDIS_PASSWORD=queuewatch-local-redis

# 認証: local(認証なし。自分のマシンだけで使う) または token(Bearer トークン)
QUEUEWATCH_AUTH_MODE=local
# token モードのトークン。`ロール=トークン` をカンマ区切り(viewer / editor / admin、12 文字以上)
# 例: QUEUEWATCH_API_TOKENS=viewer=...,editor=...,admin=...
QUEUEWATCH_API_TOKENS=

# ブラウザから API を呼べるオリジン(カンマ区切り)。`*` は明示したときだけ。既定は nginx の画面
QUEUEWATCH_CORS_ORIGINS=http://localhost:8080

# レート制限(IP ごと、1 分あたり)。既定は読み取り 300、書き込み 60
# QUEUEWATCH_RATE_LIMIT_READ_PER_MINUTE=300
# QUEUEWATCH_RATE_LIMIT_WRITE_PER_MINUTE=60

# 画面(フロントエンド)が使う API の場所と、閲覧用のトークン
# (ビルド時にバンドルへ入るため、配信される JS から読める。viewer のトークンに限る)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TOKEN=
